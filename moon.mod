name = "mldong/moon-s3"

version = "0.1.2"

license = "Apache-2.0"

preferred_target = "wasm"

description = "S3 client and Signature V4 implementation for MoonBit"

import {
  "mldong/moon-hutool@0.1.6",
  "moonbitlang/async@0.22.5",
}

readme = "README.md"

repository = "https://github.com/mldong/moon-s3"

keywords = [
  "moonbit",
  "s3",
  "sigv4",
  "minio",
  "presigned-url",
  "multipart-upload",
]
