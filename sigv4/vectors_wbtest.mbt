    http_method: Get,
    url: "http://minio.test:9000/mldong/dir/a b+c%20d.txt?prefix=a/&x=2&x=1&empty=&v=%2B",
    headers: [],
    body: @transport.RequestBody::Empty,
  }
  let input : SigningInput = {
    region: "us-east-1",
    service: "s3",
    timestamp: "20261016T010203Z",
    payload_hash: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  }
  let credentials = Credentials::new(
    "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  )
  let canonical = canonical_request(request, input, credentials)
  assert_eq(
    canonical, "GET\n/mldong/dir/a b+c%20d.txt\nempty=&prefix=a%2F&v=%252B&x=1&x=2\nhost:minio.test:9000\nx-amz-content-sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nx-amz-date:20261016T010203Z\n\nhost;x-amz-content-sha256;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  let to_sign = string_to_sign(canonical, input)
  assert_eq(
    to_sign, "AWS4-HMAC-SHA256\n20261016T010203Z\n20261016/us-east-1/s3/aws4_request\n2fd0777e5f415ee280d6f17610a433daecb4804e5f28a5c121679e228529fd4c",
  )
  let derived = derive_signing_key(credentials, input)
  assert_eq(
    @hex.encode(derived),
    "cd74bcbae49283abe23b273ff8d086a71364f5492365824f546476087f2e0dd3",
  )
  let got = calculate_signature(to_sign, derived)
  assert_eq(
    got, "347a6ac9fb637e72ebb8b557dcd3dd68db91976d9b4fdb9cfd312fb4762ee8e6",
  )
}

