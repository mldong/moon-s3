///|
test "sigv4 vector get_plain" {
  let request : @transport.Request = {
    http_method: Get,
    url: "http://minio.test:9000/mldong/plain.txt",
    headers: [],
    body: @transport.RequestBody::Empty,
  }
  let input : SigningInput = {
    region: "us-east-1",
    service: "s3",
    timestamp: "20261016T010203Z",
    payload_hash: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  }
  let credentials = Credentials::new(
    "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  )
  let canonical = canonical_request(request, input, credentials)
  assert_eq(
    canonical, "GET\n/mldong/plain.txt\n\nhost:minio.test:9000\nx-amz-content-sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nx-amz-date:20261016T010203Z\n\nhost;x-amz-content-sha256;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  let to_sign = string_to_sign(canonical, input)
  assert_eq(
    to_sign, "AWS4-HMAC-SHA256\n20261016T010203Z\n20261016/us-east-1/s3/aws4_request\n67e16e7ffe1388439f22cef1417d014fd547ee4c25ff4d6873121d571ec34816",
  )
  let derived = derive_signing_key(credentials, input)
  assert_eq(
    @hex.encode(derived),
    "cd74bcbae49283abe23b273ff8d086a71364f5492365824f546476087f2e0dd3",
  )
  let got = calculate_signature(to_sign, derived)
  assert_eq(
    got, "5d022b971f38f00f583ad73f8b8a616b19546fe52518c9ff8a8f8df0c738e646",
  )
}

