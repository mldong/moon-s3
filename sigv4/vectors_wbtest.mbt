test "sigv4 vector put_with_content_type" {
  let request : @transport.Request = {
    http_method: Put,
    url: "http://minio.test:9000/mldong/upload.bin",
    headers: [
      { name: "Content-Type", value: "application/octet-stream", },
      { name: "X-Mixed-Case", value: "  padded   value  ", },
    ],
    body: @transport.RequestBody::Empty,
  }
  let input : SigningInput = {
    region: "us-east-1",
    service: "s3",
    timestamp: "20261016T010203Z",
    payload_hash: "808b59664b6adb9274e3bbd0766e7aec9659786c22fdb825c49ca7fda1c6236e",
  }
  let credentials = Credentials::new(
    "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  )
  let canonical = canonical_request(request, input, credentials)
  assert_eq(
    canonical, "PUT\n/mldong/upload.bin\n\ncontent-type:application/octet-stream\nhost:minio.test:9000\nx-amz-content-sha256:808b59664b6adb9274e3bbd0766e7aec9659786c22fdb825c49ca7fda1c6236e\nx-amz-date:20261016T010203Z\nx-mixed-case:padded value\n\ncontent-type;host;x-amz-content-sha256;x-amz-date;x-mixed-case\n808b59664b6adb9274e3bbd0766e7aec9659786c22fdb825c49ca7fda1c6236e",
  )
  let to_sign = string_to_sign(canonical, input)
  assert_eq(
    to_sign, "AWS4-HMAC-SHA256\n20261016T010203Z\n20261016/us-east-1/s3/aws4_request\n2d600f1c4185bd839a52dc23db2c79838ff73f3039257ca4c480b1b9c6df4094",
  )
  let derived = derive_signing_key(credentials, input)
  assert_eq(
    @hex.encode(derived),
    "cd74bcbae49283abe23b273ff8d086a71364f5492365824f546476087f2e0dd3",
  )
  let got = calculate_signature(to_sign, derived)
  assert_eq(
    got, "88b9b20da316958d3066e17ea887539fa8946290ca0ebc5d501efd97e0c0d401",
  )
}

///|
test "sigv4 vector temporary_credentials" {
  let request : @transport.Request = {
    http_method: Get,
    url: "http://minio.test:9000/mldong/tmp.txt?acl",
    headers: [],
    body: @transport.RequestBody::Empty,
  }
  let input : SigningInput = {
    region: "us-east-1",
    service: "s3",
    timestamp: "20261016T010203Z",
    payload_hash: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  }
  let credentials = Credentials::new(
    "AKIDEXAMPLE",
    "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    session_token=Some("SESSION/TOKEN+value"),
  )
  let canonical = canonical_request(request, input, credentials)
  assert_eq(
    canonical, "GET\n/mldong/tmp.txt\nacl=\nhost:minio.test:9000\nx-amz-content-sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\nx-amz-date:20261016T010203Z\nx-amz-security-token:SESSION/TOKEN+value\n\nhost;x-amz-content-sha256;x-amz-date;x-amz-security-token\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  let to_sign = string_to_sign(canonical, input)
  assert_eq(
    to_sign, "AWS4-HMAC-SHA256\n20261016T010203Z\n20261016/us-east-1/s3/aws4_request\n7905575af29a31800d0a4feadb249f2450884eee783b7003c6c78232cc7a1283",
  )
  let derived = derive_signing_key(credentials, input)
  assert_eq(
    @hex.encode(derived),
    "cd74bcbae49283abe23b273ff8d086a71364f5492365824f546476087f2e0dd3",
  )
  let got = calculate_signature(to_sign, derived)
  assert_eq(
    got, "3b7e102aa642ddb89f6c849b2ef87b8487ad0460d8385d5f77f0902e86f70d51",
  )
}

///|
test "sigv4 vector presigned_get" {
  let request : @transport.Request = {
    http_method: Get,
    url: "http://minio.test:9000/mldong/share.txt?response-content-disposition=attachment",
    headers: [],
    body: @transport.RequestBody::Empty,
  }
  let input : SigningInput = {
    region: "us-east-1",
    service: "s3",
    timestamp: "20261016T010203Z",
    payload_hash: "UNSIGNED-PAYLOAD",
  }
  let credentials = Credentials::new(
    "AKIDEXAMPLE", "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  )
  let signed = presign(
    request,
    credentials,
    input.region,
    input.timestamp,
    3600,
  )
  let tail_marker = "&X-Amz-Signature="
  let pos = match signed.url.find(tail_marker) {
    Some(i) => i + tail_marker.length()
    None => -1
  }
  assert_true(pos >= 0)
  let got = signed.url[pos:signed.url.length()].to_owned()
  assert_eq(
    got, "27d7a8427054da8c5196a19d0efb15dd8c0fa02d96bab7b702e5b1c48e322f90",
  )
}
